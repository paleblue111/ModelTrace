# Optional overrides. Leave blank to generate and persist secrets automatically.
# Neither value is the upstream model API key.
MODELTRACE_API_TOKEN=
CREDENTIAL_ENCRYPTION_KEY=
BIND_ADDRESS=0.0.0.0
PORT=10001
# Optional package index used while building the Docker image.
PYPI_INDEX_URL=https://pypi.org/simple
REQUEST_TIMEOUT_SECONDS=240
TASK_TIMEOUT_SECONDS=1800
QUEUE_TIMEOUT_SECONDS=3600
RESULT_TTL_SECONDS=86400
MAX_QUEUED_TASKS=100
# Optional exact hostname allowlist, comma-separated.
UPSTREAM_ALLOWED_HOSTS=
# Only enable for trusted private/internal LLM endpoints.
ALLOW_PRIVATE_UPSTREAM=false
